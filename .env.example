# ── Basis data (Neon PostgreSQL) ───────────────────────────────────────────────
# Runtime aplikasi: connection string *pooled* (host berisi "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/ikp?sslmode=require
# Migrasi: connection string *unpooled* (tanpa "-pooler").
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/ikp?sslmode=require
# Kosongkan DATABASE_URL di laptop untuk memakai PGlite lokal (./data/pglite).

# ── Login (Better Auth) ───────────────────────────────────────────────────────
# Buat dengan: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Alamat publik aplikasi, tanpa garis miring di akhir.
BETTER_AUTH_URL=https://ikp.example.com

# ── Cron (route /api/cron/*) ──────────────────────────────────────────────────
# Buat dengan: openssl rand -hex 24
CRON_SECRET=

# ── Web push (pengingat 16.00) ────────────────────────────────────────────────
# Buat sekali dengan: npx web-push generate-vapid-keys
# NEXT_PUBLIC_* ditanam saat build: isi SEBELUM `npm run build`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@wahdah.or.id

# Port untuk `next start` (sesuaikan dengan reverse proxy Cloudways).
PORT=3000
